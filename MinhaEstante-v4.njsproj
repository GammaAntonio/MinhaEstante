<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">18.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{85CB2385-BCB6-4A76-AB78-1957E3712155}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>server.mjs</StartupFile>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <ProjectTypeGuids>{3AF33F2E-1136-4D97-BBB7-1795711AC8B8};{9092AA53-FB77-4645-B42D-1CCCA6BD08BD}</ProjectTypeGuids>
    <NodejsPort>4183</NodejsPort>
    <LaunchUrl>http://127.0.0.1:4183/</LaunchUrl>
    <StartWebBrowser>true</StartWebBrowser>
    <NodeExePath Condition="Exists('$(ProgramW6432)\nodejs\node.exe')">$(ProgramW6432)\nodejs\node.exe</NodeExePath>
    <NodeExePath Condition="'$(NodeExePath)' == '' And Exists('$(USERPROFILE)\.cache\codex-runtimes\codex-primary-runtime\dependencies\node\bin\node.exe')">$(USERPROFILE)\.cache\codex-runtimes\codex-primary-runtime\dependencies\node\bin\node.exe</NodeExePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="*.js;*.mjs;*.html;*.css;*.svg;*.json;*.md;*.ps1;.gitignore" />
    <Content Include="tests\*.mjs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="tests\" />
  </ItemGroup>
  <Import Project="$(VSToolsPath)\Node.js Tools\Microsoft.NodejsToolsV2.targets" />
</Project>